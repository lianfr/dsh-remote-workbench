{
  "name": "dsh-remote-workbench",
  "version": "0.1.0",
  "description": "DSH per-conversation remote server workbench powered by local OpenSSH",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.2-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "files": [
    "icon.svg",
    "src/index.js",
    "src/client.js",
    "src/host/",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "remote-host",
    "conversation-view"
  ],
  "license": "MIT",
  "icon": "./icon.svg"
}
